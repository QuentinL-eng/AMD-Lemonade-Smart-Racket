# Local secrets for Smart Racket / Tennis Buddee. Never commit this file.
# Fill in the values you need; leave the rest blank.

# Hugging Face: downloads Llama 3.2 3B weights for the on-device coach
HF_TOKEN=

# Cloudflare: deploying the website with wrangler
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Meta Model API (api.meta.ai): Muse Spark for the online assistant and SAM 3.1 for video tools.
# The `muse` edge function reads the same key from the Supabase secret META_API_KEY:
#   supabase secrets set META_API_KEY=...
# Optional function secrets: MUSE_MODEL (default muse-spark-1.3), MUSE_BASE_URL, MUSE_REASONING_EFFORT (default low)
MUSE_API_KEY=

# Anthropic / OpenAI: LLM features and tooling
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Apple: App Store Connect API (TestFlight uploads)
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_PATH=
